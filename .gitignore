# Local media & pipeline output (privacy)
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# User taste & secrets (never commit)
preferences.yaml
preferences.yml
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.envrc

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Generated presentation copies under output are ignored via output/*
*.log
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
